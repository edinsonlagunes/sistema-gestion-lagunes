# En local puedes dejar esta línea comentada: usará SQLite automáticamente.
# En Railway, copia aquí la URL de conexión de tu base de datos PostgreSQL.
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd

# Clave secreta para firmar los tokens de login. Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# y ponla como variable de entorno SECRET_KEY tanto en local como en Railway.
# Si no la defines, se usa una clave de desarrollo (NO segura para producción).
# SECRET_KEY=pon-aqui-tu-clave-generada
